{
  "name": "systemone-voice-computer-use",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "start": "zsh scripts/start.sh",
    "traces": "node scripts/show-traces.ts",
    "eval:agent": "node scripts/eval-agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test packages/protocol/test/*.test.ts packages/runtime/test/*.test.ts packages/fixtures/test/*.test.ts packages/browser/test/*.test.ts packages/providers/test/*.test.ts extensions/chrome/test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "test:swift": "swift test --package-path packages/protocol/swift",
    "test:mac-peer": "scripts/check-peer-identity.sh",
    "test:chrome-host": "zsh scripts/check-chrome-native-host.sh",
    "test:chrome-browser-transport": "node scripts/check-chrome-browser-transport.mjs",
    "test:native-ax": "zsh scripts/check-native-ax.sh",
    "test:native-permit-digest": "node scripts/check-native-permit-digest.mjs",
    "test:native-worker-ledger": "node scripts/check-native-worker-ledger.mjs",
    "test:native-host-permit": "node scripts/check-native-host-permit.mjs",
    "test:mac-launch": "zsh scripts/test-native-mock-processes.sh",
    "build:native-mock": "scripts/build-native-mock.sh",
    "run:native-mock": "scripts/run-native-mock.sh",
    "build:native-dev": "zsh scripts/build-native-dev.sh",
    "run:native-dev": "zsh scripts/run-native-dev.sh",
    "test:task-command": "zsh scripts/check-task-command.sh",
    "test:voice-permission-callback": "zsh scripts/check-voice-permission-callback.sh",
    "test:dev-task-intake": "zsh scripts/check-dev-task-intake.sh",
    "test:window-visibility": "zsh scripts/check-command-window-visibility.sh",
    "test:host-lifecycle": "zsh scripts/check-host-lifecycle.sh",
    "test:field-preflight": "zsh scripts/check-command-field-preflight.sh",
    "configure:dev-signing": "python3 scripts/development_signing.py configure",
    "test:dev-signing": "python3 -m unittest discover -s scripts -p 'test_development_signing.py'",
    "test:adhoc-identity": "zsh scripts/check-adhoc-identity.sh",
    "test:accessibility-recovery": "zsh scripts/check-accessibility-recovery.sh",
    "try:local": "zsh scripts/try-local.sh",
    "run:portal-fixture": "node scripts/run-portal-fixture.ts",
    "fixtures": "node scripts/export-fixtures.ts",
    "inventory:write": "node scripts/release-dependency-inventory.mjs --write",
    "inventory:check": "node scripts/release-dependency-inventory.mjs --check",
    "test:release-inventory": "npm run inventory:check && node --test scripts/test-release-dependency-inventory.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
