{
  "name": "systemone-voice-computer-use",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test packages/protocol/test/*.test.ts packages/runtime/test/*.test.ts packages/fixtures/test/*.test.ts packages/browser/test/*.test.ts packages/providers/test/*.test.ts extensions/chrome/test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "test:swift": "swift test --package-path packages/protocol/swift",
    "test:mac-peer": "scripts/check-peer-identity.sh",
    "test:chrome-host": "zsh scripts/check-chrome-native-host.sh",
    "test:chrome-browser-transport": "node scripts/check-chrome-browser-transport.mjs",
    "test:native-ax": "zsh scripts/check-native-ax.sh",
    "test:native-permit-digest": "node scripts/check-native-permit-digest.mjs",
    "test:native-worker-ledger": "node scripts/check-native-worker-ledger.mjs",
    "test:native-host-permit": "node scripts/check-native-host-permit.mjs",
    "test:mac-launch": "zsh scripts/test-native-mock-processes.sh",
    "build:native-mock": "scripts/build-native-mock.sh",
    "run:native-mock": "scripts/run-native-mock.sh",
    "build:native-dev": "zsh scripts/build-native-dev.sh",
    "run:native-dev": "zsh scripts/run-native-dev.sh",
    "run:portal-fixture": "node scripts/run-portal-fixture.ts",
    "fixtures": "node scripts/export-fixtures.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
